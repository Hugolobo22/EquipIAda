# Escolha "ollama" para usar um modelo instalado no próprio computador.
# "openai" só funciona após ativação explícita da opção paga.
ANSWER_PROVIDER=
OLLAMA_MODEL=qwen3:4b-instruct
OPENAI_ENABLE_PAID_CALLS=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MAX_REQUESTS_PER_HOUR=
OPENAI_MAX_OUTPUT_TOKENS=512
